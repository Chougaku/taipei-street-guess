# ── Google Maps ─────────────────────────────────────────────
# Browser key (restrict by HTTP referrer; Maps JavaScript API only)
VITE_GOOGLE_MAPS_API_KEY=
# Map ID for the guess map (Cloud-based map styling). DEMO_MAP_ID works for development.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
# Server key (Street View Static API metadata only; never shipped to the browser)
GOOGLE_MAPS_SERVER_KEY=

# ── Supabase (leave empty to run the server in local dev mode with an embedded Postgres) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase → Project Settings → Database → Connection string, "Session pooler")
DATABASE_URL=

# ── Server ──────────────────────────────────────────────────
PORT=8787
# Only used in local dev mode to sign guest tokens
DEV_JWT_SECRET=dev-only-secret-change-me
