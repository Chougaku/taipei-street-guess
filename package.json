{
  "name": "taipei-guessr",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "play": "node scripts/play.mjs",
    "start": "node scripts/play.mjs --no-open",
    "dev": "npm run dev --workspace @tg/server & npm run dev --workspace @tg/web",
    "dev:web": "npm run dev --workspace @tg/web",
    "dev:server": "npm run dev --workspace @tg/server",
    "build": "npm run build --workspace @tg/web && npm run build --workspace @tg/server",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "geo:build": "npm run build --workspace @tg/geo-build",
    "locations:gen": "npm run gen --workspace @tg/location-gen",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
